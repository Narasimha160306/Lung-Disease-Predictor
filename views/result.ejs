<%- include('partials/header', { title: 'Result', activePage: 'result' }) %>

<div class="page-hero result-hero">
  <div class="container">
    <span class="section-kicker">Analysis Complete</span>
    <h1>Your Prediction Result</h1>
    <p>Based on the symptoms you entered, here is your lung health assessment.</p>
  </div>
</div>

<section class="result-section">
  <div class="container">
    <!-- Primary Result Card -->
    <div class="result-card result-<%= result.riskLevel %>">
      <div class="result-card-glow" aria-hidden="true"></div>
      <div class="result-main">
        <div class="result-badge">
          <span class="result-badge-dot"></span>
          ML Predicted Condition
        </div>

        <div class="result-title">
          <div class="result-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <% if (result.diseaseKey === 'healthy') { %>
                <path d="M12 2 3 7v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V7l-9-5z" />
                <path d="M9 12l2 2 4-4" />
              <% } else { %>
                <path d="M12 2C9.5 4 6.5 5 6.5 8.5c0 2 1.5 3 1.5 5 0 1.5-1 2.5-1 5 0 2.5 2 3.5 5 3.5" />
                <path d="M12 2c2.5 2 5.5 3 5.5 6.5 0 2-1.5 3-1.5 5 0 1.5 1 2.5 1 5 0 2.5-2 3.5-5 3.5" />
              <% } %>
            </svg>
          </div>
          <div>
            <h2><%= result.disease %></h2>
            <span class="result-subtitle">Confidence Score</span>
          </div>
        </div>

        <div class="score-display">
          <div class="score-circle" data-score="<%= result.confidence %>">
            <div class="score-circle-inner">
              <strong><%= result.confidence %>%</strong>
              <span>Confidence</span>
            </div>
          </div>
        </div>

        <p class="result-description"><%= result.description %></p>

        <% if (result.modelMetrics) { %>
          <p class="model-meta">
            Random Forest · <%= result.modelMetrics.nTrees %> trees ·
            trained on <%= result.modelMetrics.nTrainSamples.toLocaleString() %> cases ·
            validation accuracy <%= Math.round(result.modelMetrics.testAccuracy * 1000) / 10 %>%
          </p>
        <% } %>

        <div class="specialist-card">
          <span class="specialist-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          </span>
          <div>
            <span class="specialist-label">Suggested Specialist</span>
            <strong class="specialist-name"><%= result.specialist %></strong>
          </div>
        </div>
      </div>

      <div class="result-risk">
        <div class="risk-header">
          <h3>Risk Indicator</h3>
          <span class="risk-pill risk-<%= result.riskLevel %>"><%= result.riskLevel.replace('-', ' ') %></span>
        </div>

        <div class="risk-bar">
          <div class="risk-bar-track"></div>
          <div class="risk-bar-fill" data-width="<%= result.confidence %>" data-level="<%= result.riskLevel %>"></div>
        </div>
        <div class="risk-legend">
          <span>Low</span>
          <span>Moderate</span>
          <span>High</span>
          <span>Critical</span>
        </div>

        <div class="risk-stats">
          <div class="risk-stat">
            <span>Confidence</span>
            <strong><%= result.confidence %>%</strong>
          </div>
          <div class="risk-stat">
            <span>Risk Level</span>
            <strong class="text-<%= result.riskLevel %>"><%= result.riskLevel.replace('-', ' ') %></strong>
          </div>
        </div>
      </div>
    </div>

    <% if (result.alternatives && result.alternatives.length) { %>
      <div class="alternatives-card">
        <div class="summary-header">
          <h3>Other Model Probabilities</h3>
          <span>Next most likely conditions</span>
        </div>
        <div class="alt-list">
          <% result.alternatives.forEach(function(alt) { %>
            <div class="alt-row">
              <div class="alt-info">
                <strong><%= alt.name %></strong>
                <span><%= alt.probability %>%</span>
              </div>
              <div class="alt-bar">
                <div class="alt-bar-fill" data-width="<%= alt.probability %>"></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Causes & Precautions -->
    <div class="result-details-grid">
      <div class="detail-card">
        <div class="detail-card-header">
          <span class="detail-icon cause-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4M12 8h.01" />
            </svg>
          </span>
          <h3>Possible Causes</h3>
        </div>
        <ul class="detail-list">
          <% result.causes.forEach(function(cause) { %>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span><%= cause %></span>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="detail-card">
        <div class="detail-card-header">
          <span class="detail-icon precaution-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </span>
          <h3>Recommended Precautions</h3>
        </div>
        <ul class="detail-list">
          <% result.precautions.forEach(function(precaution) { %>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span><%= precaution %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <!-- Symptom Summary -->
    <div class="symptom-summary-card">
      <div class="summary-header">
        <h3>Symptom Summary</h3>
        <span>What you entered</span>
      </div>
      <div class="chips">
        <span class="chip"><strong>Age:</strong> <%= symptoms.age %></span>
        <span class="chip"><strong>Gender:</strong> <%= symptoms.gender.charAt(0).toUpperCase() + symptoms.gender.slice(1) %></span>
        <span class="chip"><strong>Smoking:</strong> <%= symptoms.smokingHistory === 'no' ? 'Never' : symptoms.smokingHistory === 'ex-smoker' ? 'Ex-Smoker' : 'Current' %></span>
        <span class="chip"><strong>Chest Pain:</strong> <%= symptoms.chestPain %></span>
        <span class="chip"><strong>Cough:</strong> <%= symptoms.cough %></span>
        <span class="chip"><strong>Breathing:</strong> <%= symptoms.breathingDifficulty %></span>
        <span class="chip"><strong>Fatigue:</strong> <%= symptoms.fatigue %></span>
        <span class="chip"><strong>Wheezing:</strong> <%= symptoms.wheezing %></span>
        <span class="chip"><strong>Fever:</strong> <%= symptoms.fever %></span>
        <span class="chip"><strong>Weight Loss:</strong> <%= symptoms.weightLoss %></span>
      </div>
    </div>

    <!-- Actions -->
    <div class="result-actions">
      <a href="/predict" class="btn btn-outline btn-lg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        New Prediction
      </a>
      <a href="/history" class="btn btn-primary btn-lg">
        View History
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="medical-disclaimer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 8v4M12 16h.01" />
      </svg>
      <p>
        <strong>Disclaimer:</strong> This is an AI-assisted screening tool and does not replace professional medical
        diagnosis. Always consult a qualified doctor for a definitive assessment.
      </p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
